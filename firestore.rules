rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       USERS
    ===================================================== */

    match /users/{userId} {

      /*
       * Logged-in users can read user profiles.
       */
      allow read: if request.auth != null;

      /*
       * A user can create only their own account.
       */
      allow create:
        if request.auth != null
        && request.auth.uid == userId;

      /*
       * A user can update only their own account.
       */
      allow update:
        if request.auth != null
        && request.auth.uid == userId;

      /*
       * Do not allow users to delete accounts
       * from the client.
       */
      allow delete: if false;
    }


    /* =====================================================
       PRIVATE CHATS
    ===================================================== */

    match /chats/{chatId} {

      /*
       * READ
       *
       * Only a participant in the chat can read
       * the chat document.
       */
      allow read:
        if request.auth != null
        && request.auth.uid in resource.data.participants;


      /*
       * CREATE
       *
       * The user creating the chat must be one of
       * the participants.
       */
      allow create:
        if request.auth != null
        && request.auth.uid in request.resource.data.participants;


      /*
       * UPDATE
       *
       * Only an existing participant can update
       * the chat.
       *
       * Also make sure the updated document still
       * contains the authenticated user as a participant.
       */
      allow update:
        if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.auth.uid in request.resource.data.participants;


      /*
       * Prevent client-side deletion of chats.
       */
      allow delete: if false;


      /* =================================================
         PRIVATE CHAT MESSAGES
      ================================================= */

      match /messages/{messageId} {

        /*
         * READ
         *
         * Only participants of the parent chat can
         * read its messages.
         *
         * User C cannot read A <-> B messages.
         */
        allow read:
          if request.auth != null
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.participants;


        /*
         * CREATE
         *
         * The sender must be the currently logged-in user.
         *
         * The receiver must be one of the chat participants.
         *
         * The sender must also be one of the participants.
         */
        allow create:
          if request.auth != null
          && request.auth.uid ==
             request.resource.data.senderId
          && request.resource.data.receiverId != null
          && request.resource.data.senderId != null
          && request.resource.data.receiverId in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.participants
          && request.resource.data.senderId in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.participants;


        /*
         * UPDATE
         *
         * Only a participant can update the message.
         *
         * This allows things such as:
         * - delivered = true
         * - read = true
         * - readAt
         * - deliveredAt
         */
        allow update:
          if request.auth != null
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.participants;


        /*
         * Do not allow client-side message deletion.
         */
        allow delete: if false;
      }
    }
  }
}
